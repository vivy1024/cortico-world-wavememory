{
  "name": "cortico-world-wavememory",
  "version": "0.3.0",
  "type": "module",
  "description": "Cortico World: WaveMemory 注入（与 AstrBot 同一编排器）、对话/口播/游戏经历写回、身份安全提示与工具注册表代理",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "wavememory",
    "memory"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "describe": "describe.json"
  },
  "files": [
    "src",
    "README.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "backfill:games": "tsx scripts/backfill-game-events.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
